{
  "name": "polyglot-project-explorer",
  "displayName": "Polyglot Project Explorer",
  "description": "Browse Go and C# projects without changing the workspace folders.",
  "publisher": "tanding0304",
  "version": "0.1.8",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "repository": { "type": "git", "url": "https://github.com/tanding0304/vscode-polyglot-project-explorer" },
  "scripts": { "test": "node --check extension.js && node --check csharp-solution.js && node --check go-module.js" },
  "contributes": {
    "viewsWelcome": [{ "view": "polyglotProjects.tree", "contents": "在工作区根目录添加 polyglot-projects.json，并在 projects 数组中列出工程文件路径。" }],
    "viewsContainers": { "activitybar": [{ "id": "polyglotProjects", "title": "工程", "icon": "projects.svg" }] },
    "views": { "polyglotProjects": [{ "id": "polyglotProjects.tree", "name": "工程" }] },
    "commands": [
      { "command": "polyglotProjects.runCode", "title": "Run Code" },
      { "command": "polyglotProjects.refresh", "title": "刷新工程", "icon": "$(refresh)" },
      { "command": "polyglotProjects.run", "title": "运行启动配置" },
      { "command": "polyglotProjects.debug", "title": "调试启动配置" },
      { "command": "polyglotProjects.dotnetBuild", "title": "生成 (Build)" },
      { "command": "polyglotProjects.dotnetRebuild", "title": "重新生成 (Rebuild)" },
      { "command": "polyglotProjects.dotnetClean", "title": "清理 (Clean)" },
      { "command": "polyglotProjects.dotnetRestore", "title": "还原 (Restore)" },
      { "command": "polyglotProjects.dotnetTest", "title": "运行测试 (Test)" },
      { "command": "polyglotProjects.dotnetPublish", "title": "发布 (Publish)" },
      { "command": "polyglotProjects.goBuild", "title": "Go: Build (go build ./...)" },
      { "command": "polyglotProjects.goTest", "title": "Go: Test (go test ./...)" },
      { "command": "polyglotProjects.goTestPkg", "title": "Go: 运行当前包测试 (go test -v .)" },
      { "command": "polyglotProjects.goVet", "title": "Go: Vet (go vet ./...)" },
      { "command": "polyglotProjects.goModTidy", "title": "Go: Mod Tidy (go mod tidy)" },
      { "command": "polyglotProjects.goModDownload", "title": "Go: Mod Download (go mod download)" },
      { "command": "polyglotProjects.goModVerify", "title": "Go: Mod Verify (go mod verify)" },
      { "command": "polyglotProjects.goModVendor", "title": "Go: Mod Vendor (go mod vendor)" },
      { "command": "polyglotProjects.goModGraph", "title": "Go: Mod Graph (go mod graph)" }
    ],
    "menus": {
      "view/title": [{ "command": "polyglotProjects.refresh", "when": "view == polyglotProjects.tree", "group": "navigation" }],
      "view/item/context": [
        { "command": "polyglotProjects.runCode", "when": "view == polyglotProjects.tree && (viewItem == polyglotGoMain || viewItem == polyglotGoTest || viewItem == polyglotSource)" },
        { "command": "polyglotProjects.run", "when": "view == polyglotProjects.tree && (viewItem == polyglotProject || viewItem == polyglotGoModule || viewItem == polyglotGoMain || viewItem == polyglotCsharpProject || viewItem == polyglotCsharpSolution)" },
        { "command": "polyglotProjects.debug", "when": "view == polyglotProjects.tree && (viewItem == polyglotProject || viewItem == polyglotGoModule || viewItem == polyglotGoMain || viewItem == polyglotCsharpProject || viewItem == polyglotCsharpSolution)" },
        { "command": "polyglotProjects.goBuild", "when": "view == polyglotProjects.tree && viewItem == polyglotGoModule", "group": "go@1" },
        { "command": "polyglotProjects.goTest", "when": "view == polyglotProjects.tree && viewItem == polyglotGoModule", "group": "go@2" },
        { "command": "polyglotProjects.goVet", "when": "view == polyglotProjects.tree && viewItem == polyglotGoModule", "group": "go@3" },
        { "command": "polyglotProjects.goModTidy", "when": "view == polyglotProjects.tree && (viewItem == polyglotGoModule || viewItem == polyglotGoModFile)", "group": "gomod@1" },
        { "command": "polyglotProjects.goModDownload", "when": "view == polyglotProjects.tree && (viewItem == polyglotGoModule || viewItem == polyglotGoModFile)", "group": "gomod@2" },
        { "command": "polyglotProjects.goModVerify", "when": "view == polyglotProjects.tree && viewItem == polyglotGoModFile", "group": "gomod@3" },
        { "command": "polyglotProjects.goModVendor", "when": "view == polyglotProjects.tree && viewItem == polyglotGoModFile", "group": "gomod@4" },
        { "command": "polyglotProjects.goModGraph", "when": "view == polyglotProjects.tree && viewItem == polyglotGoModFile", "group": "gomod@5" },
        { "command": "polyglotProjects.goTestPkg", "when": "view == polyglotProjects.tree && viewItem == polyglotGoTest", "group": "go@1" },
        { "command": "polyglotProjects.dotnetBuild", "when": "view == polyglotProjects.tree && (viewItem == polyglotCsharpSolution || viewItem == polyglotCsharpProject)", "group": "dotnet@1" },
        { "command": "polyglotProjects.dotnetRebuild", "when": "view == polyglotProjects.tree && (viewItem == polyglotCsharpSolution || viewItem == polyglotCsharpProject)", "group": "dotnet@2" },
        { "command": "polyglotProjects.dotnetClean", "when": "view == polyglotProjects.tree && (viewItem == polyglotCsharpSolution || viewItem == polyglotCsharpProject)", "group": "dotnet@3" },
        { "command": "polyglotProjects.dotnetRestore", "when": "view == polyglotProjects.tree && (viewItem == polyglotCsharpSolution || viewItem == polyglotCsharpProject)", "group": "dotnet@4" },
        { "command": "polyglotProjects.dotnetTest", "when": "view == polyglotProjects.tree && (viewItem == polyglotCsharpSolution || viewItem == polyglotCsharpProject)", "group": "dotnet@5" },
        { "command": "polyglotProjects.dotnetPublish", "when": "view == polyglotProjects.tree && (viewItem == polyglotCsharpSolution || viewItem == polyglotCsharpProject)", "group": "dotnet@6" }
      ]
    }
  }
}
