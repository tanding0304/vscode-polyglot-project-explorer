{
  "name": "polyglot-project-explorer",
  "displayName": "Polyglot Project Explorer",
  "description": "Browse Go and C# projects without changing the workspace folders.",
  "publisher": "tanding0304",
  "version": "0.1.0",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "repository": { "type": "git", "url": "https://github.com/tanding0304/vscode-polyglot-project-explorer" },
  "scripts": { "test": "node --check extension.js" },
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "polyglotProjects", "title": "工程", "icon": "projects.svg" }] },
    "views": { "polyglotProjects": [{ "id": "polyglotProjects.tree", "name": "Go / C# 工程" }] },
    "commands": [
      { "command": "polyglotProjects.refresh", "title": "刷新工程", "icon": "$(refresh)" },
      { "command": "polyglotProjects.run", "title": "运行启动配置" },
      { "command": "polyglotProjects.debug", "title": "调试启动配置" }
    ],
    "menus": {
      "view/title": [{ "command": "polyglotProjects.refresh", "when": "view == polyglotProjects.tree", "group": "navigation" }],
      "view/item/context": [
        { "command": "polyglotProjects.run", "when": "view == polyglotProjects.tree && viewItem == polyglotProject" },
        { "command": "polyglotProjects.debug", "when": "view == polyglotProjects.tree && viewItem == polyglotProject" }
      ]
    }
  }
}
